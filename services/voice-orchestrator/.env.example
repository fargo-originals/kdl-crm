# Servidor
PORT=8080
# URL pública del servicio (para construir el stream_url WSS de Telnyx). Ej: voice.kentodevlab.com
PUBLIC_URL=https://voice-orchestrator.up.railway.app

# Secreto compartido con el CRM (mismo valor que VOICE_SHARED_SECRET en el CRM)
VOICE_SHARED_SECRET=

# Redis (cola BullMQ). Railway provee REDIS_URL al añadir el plugin Redis.
REDIS_URL=redis://localhost:6379

# Telnyx (Call Control + media streaming)
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
VOICE_FROM_NUMBER=+34...

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Cartesia (TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# OpenAI (LLM del bucle de voz)
OPENAI_API_KEY=
VOICE_LLM_MODEL=gpt-4o-mini

# Límites
VOICE_MAX_CONCURRENT=5
